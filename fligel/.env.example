# Скопируйте в .env и заполните

# Подключение к PostgreSQL (сервер в России — требование 152-ФЗ)
DATABASE_URL=postgresql://fligel:ПАРОЛЬ@127.0.0.1:5432/fligel

# Длинная случайная строка. Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Адрес, по которому сервис доступен из интернета. Из него строятся ссылки календарей для площадок
PUBLIC_BASE_URL=https://booking.example.ru

# Часовой пояс гостиницы (по нему считаются «сегодня», дайджест, уборка). Примеры: Europe/Moscow,
# Asia/Yekaterinburg, Asia/Novosibirsk, Asia/Vladivostok. Один пояс на весь аккаунт.
APP_TIMEZONE=Europe/Moscow

# Как часто забирать календари площадок, минут
SYNC_INTERVAL_MINUTES=15

# Сколько дней действует вход без повторного ввода пароля (в часах)
TOKEN_TTL_HOURS=720

# Только для docker compose: пароль базы данных
POSTGRES_PASSWORD=

# Уведомления в Telegram: не заполняйте, пока не создадите бота через @BotFather.
# Без токена раздел «Уведомления» в приложении отключён — ничего никуда не отправляется.
TELEGRAM_BOT_TOKEN=
# Необязательно: секрет вебхука, чтобы никто посторонний не мог слать запросы на
# /api/telegram/webhook от имени Telegram. Придумайте случайную строку и укажите её же
# при подключении вебхука: curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://ваш-домен/api/telegram/webhook&secret_token=<эта строка>"
TELEGRAM_WEBHOOK_SECRET=
# Час (0-23, по времени сервера), не раньше которого отправлять утренний дайджест заездов/выездов
TELEGRAM_DIGEST_HOUR=8

# Восстановление пароля по email: не заполняйте, пока не заведёте почтовый ящик для рассылки.
# Без SMTP_HOST ссылка для восстановления пароля просто пишется в лог сервера (годится для
# разработки и тестов, но не для реальных гостей — на боевом сервере заполните эти поля).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Необязательно: адрес отправителя, если отличается от SMTP_USER
SMTP_FROM=
SMTP_USE_TLS=1

# Сколько неудачных попыток входа подряд до временной блокировки, и на сколько минут
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
