# Скопируйте в .env и заполните

# Подключение к PostgreSQL (сервер в России — требование 152-ФЗ)
DATABASE_URL=postgresql://fligel:ПАРОЛЬ@127.0.0.1:5432/fligel

# Длинная случайная строка. Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Адрес, по которому сервис доступен из интернета. Из него строятся ссылки календарей для площадок
PUBLIC_BASE_URL=https://booking.example.ru

# Часовой пояс гостиницы (по нему считаются «сегодня», дайджест, уборка). Примеры: Europe/Moscow,
# Asia/Yekaterinburg, Asia/Novosibirsk, Asia/Vladivostok. Один пояс на весь аккаунт.
APP_TIMEZONE=Europe/Moscow

# Как часто забирать календари площадок, минут
SYNC_INTERVAL_MINUTES=15

# Сколько дней действует вход без повторного ввода пароля (в часах)
TOKEN_TTL_HOURS=720

# Только для docker compose: пароль базы данных
POSTGRES_PASSWORD=

# Уведомления в Telegram: не заполняйте, пока не создадите бота через @BotFather.
# Без токена раздел «Уведомления» в приложении отключён — ничего никуда не отправляется.
TELEGRAM_BOT_TOKEN=
# Необязательно: секрет вебхука, чтобы никто посторонний не мог слать запросы на
# /api/telegram/webhook от имени Telegram. Придумайте случайную строку и укажите её же
# при подключении вебхука: curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://ваш-домен/api/telegram/webhook&secret_token=<эта строка>"
TELEGRAM_WEBHOOK_SECRET=
# Час (0-23, по времени сервера), не раньше которого отправлять утренний дайджест заездов/выездов
TELEGRAM_DIGEST_HOUR=8

# Восстановление пароля по email: не заполняйте, пока не заведёте почтовый ящик для рассылки.
# Без SMTP_HOST ссылка для восстановления пароля просто пишется в лог сервера (годится для
# разработки и тестов, но не для реальных гостей — на боевом сервере заполните эти поля).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Необязательно: адрес отправителя, если отличается от SMTP_USER
SMTP_FROM=
SMTP_USE_TLS=1

# Сколько неудачных попыток входа подряд до временной блокировки, и на сколько минут
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Заявки с сайта: через сколько часов снимать неподтверждённую заявку (0 — не снимать)
REQUEST_TTL_HOURS=48
# Защита формы бронирования от спама: заявок с одного IP в час и неподтверждённых заявок с одного телефона
PUBLIC_BOOKINGS_PER_HOUR=20
MAX_PENDING_PER_PHONE=3
# Запросов восстановления пароля с одного IP в час
RESET_REQUESTS_PER_HOUR=10

# Уведомления в MAX: не заполняйте, пока нет бота. Бота MAX можно создать только от верифицированного
# юридического лица или ИП в РФ (правило платформы); токен выдаёт платформа. Без токена всё выключено.
MAX_BOT_TOKEN=
# Имя бота (для ссылки привязки https://max.ru/<имя>?start=<код>) и секрет вебхука
MAX_BOT_USERNAME=
MAX_WEBHOOK_SECRET=
# MAX_API_BASE=https://platform-api.max.ru

# ---- Продажа сервиса (раунд 5) ----
# Публичная демо-версия без регистрации (кнопка на лендинге): 1 — включить; демо-аккаунт создаётся командой `python -m app.demo`
# (он же сбрасывается каждую ночь после DEMO_RESET_HOUR)
DEMO_ENABLED=0
DEMO_RESET_HOUR=4
# Цены тарифов, ₽ в месяц (те же, что на лендинге)
PRICE_START=990
PRICE_BUSINESS=2490
PRICE_PRO=4490
# Реквизиты продавца — печатаются на счетах клиентам. Заполните ДО выставления первого счёта.
SELLER_NAME=
SELLER_INN=
SELLER_KPP=
SELLER_OGRN=
SELLER_ADDRESS=
SELLER_BANK=
SELLER_BIK=
SELLER_ACCOUNT=
SELLER_CORR_ACCOUNT=
SELLER_PHONE=
SELLER_EMAIL=
# ФИО руководителя или ИП для подписи, и строка про НДС/УСН на счёте (например «Без НДС (УСН)») — её нужно указать самому
SELLER_SIGNER=
SELLER_VAT_NOTE=
# Панель оператора (/operator/): сколько попыток входа с одного IP за 10 минут. Оператора заводят командой
#   python -m app.admin create-operator <email>
OPERATOR_LOGIN_PER_10MIN=10
# Публичный API: запросов в минуту на ключ
API_REQUESTS_PER_MINUTE=120
# Только для разработки: разрешить вебхуки на http и локальные адреса (в продакшене не включать)
# WEBHOOK_ALLOW_HTTP=0
