# Скопируйте в .env и заполните

# Подключение к PostgreSQL (сервер в России — требование 152-ФЗ)
DATABASE_URL=postgresql://fligel:ПАРОЛЬ@127.0.0.1:5432/fligel

# Длинная случайная строка. Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Адрес, по которому сервис доступен из интернета. Из него строятся ссылки календарей для площадок
PUBLIC_BASE_URL=https://booking.example.ru

# Как часто забирать календари площадок, минут
SYNC_INTERVAL_MINUTES=15

# Сколько дней действует вход без повторного ввода пароля (в часах)
TOKEN_TTL_HOURS=720

# Только для docker compose: пароль базы данных
POSTGRES_PASSWORD=
