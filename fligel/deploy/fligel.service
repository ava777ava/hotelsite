# Запуск без Docker: /etc/systemd/system/fligel.service
# systemctl daemon-reload && systemctl enable --now fligel
[Unit]
Description=Fligel booking service
After=network.target postgresql.service

[Service]
User=fligel
WorkingDirectory=/opt/fligel
ExecStart=/opt/fligel/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
